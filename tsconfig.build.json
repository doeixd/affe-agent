{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "dist",
    "rootDir": "src",
    // /sandbox's local provider is the one module that runs on Node
    // primitives directly; without this the build cannot see its types.
    "types": ["node"],
    "lib": ["ES2022", "DOM"]
  },
  "include": ["src"],
  "exclude": ["src/cloudflare"]
}
