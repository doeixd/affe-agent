{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "strict": true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      // Every published subpath, and nothing else.
      //
      // A `"affe-agent/*"` wildcard used to sit here, and it
      // resolved any subpath to source whether or not `package.json#exports`
      // declared one -- so an example could import a path that does not exist
      // in the published package and `typecheck` stayed green. Enumerating
      // them makes a typo or an undeclared entry a compile error, which is the
      // only place it can be caught before a consumer hits it.
      //
      // Generated from `package.json#exports`; `verify:package` proves the
      // other direction, that each of these resolves from the packed tarball.
      "affe-agent": ["./src/index.ts"],
      "affe-agent/durable": ["./src/durable/index.ts"],
      "affe-agent/cluster": ["./src/cluster/index.ts"],
      "affe-agent/testing": ["./src/testing/index.ts"],
      "affe-agent/compaction": ["./src/compaction/index.ts"],
      "affe-agent/client": ["./src/client/index.ts"],
      "affe-agent/rpc": ["./src/rpc/index.ts"],
      "affe-agent/http": ["./src/http/index.ts"],
      "affe-agent/ag-ui": ["./src/ag-ui/index.ts"],
      "affe-agent/coding": ["./src/coding/index.ts"],
      "affe-agent/presets": ["./src/presets/index.ts"],
      "affe-agent/tree": ["./src/tree/index.ts"],
      "affe-agent/export": ["./src/export/index.ts"],
      "affe-agent/sessions": ["./src/sessions/index.ts"],
      "affe-agent/relay": ["./src/relay/index.ts"],
      "affe-agent/redaction": ["./src/redaction/index.ts"],
      "affe-agent/web": ["./src/web/index.ts"],
      "affe-agent/web/brave": ["./src/web/brave.ts"],
      "affe-agent/web/http": ["./src/web/http.ts"],
      "affe-agent/subagent": ["./src/subagent/index.ts"],
      "affe-agent/state": ["./src/state/index.ts"],
      "affe-agent/skills": ["./src/skills/index.ts"],
      "affe-agent/memory": ["./src/memory/index.ts"],
      "affe-agent/evals": ["./src/evals/index.ts"],
      "affe-agent/observability": ["./src/observability/index.ts"],
      "affe-agent/data": ["./src/data/index.ts"],
      "affe-agent/connectors": ["./src/connectors/index.ts"],
      "affe-agent/connectors/slack": ["./src/connectors/slack.ts"],
      "affe-agent/hooks": ["./src/hooks/index.ts"],
      "affe-agent/scheduling": ["./src/scheduling/index.ts"],
      "affe-agent/plugins": ["./src/plugins/index.ts"],
      "affe-agent/budget": ["./src/budget/index.ts"],
      "affe-agent/durable-streams": ["./src/durable-streams/index.ts"],
      "affe-agent/openai": ["./src/openai/index.ts"],
      "affe-agent/a2a": ["./src/a2a/index.ts"],
      "affe-agent/mcp": ["./src/mcp/index.ts"],
      "affe-agent/elicitation": ["./src/Elicitation.ts"],
      "affe-agent/tool-source": ["./src/toolSource/index.ts"],
      "affe-agent/shell": ["./src/shell/index.ts"],
      "affe-agent/sandbox": ["./src/sandbox/index.ts"],
      "affe-agent/sandbox/local": ["./src/sandbox/local.ts"],
      "affe-agent/process": ["./src/process/index.ts"],
      "affe-agent/mcp/v1": ["./src/mcp/v1/index.ts"],
      "affe-agent/mcp/v2": ["./src/mcp/v2/index.ts"],
      "affe-agent/pi": ["./src/pi/index.ts"],
      "affe-agent/cloudflare": ["./src/cloudflare/index.ts"]
    },
    "plugins": [{ "name": "@effect/language-service" }]
  },
  "include": ["src", "test", "examples", "vitest.config.ts"],
  // The Cloudflare host entry compiles under tsconfig.cloudflare.json: its
  // types reach the Workers globals, which collide with the DOM lib here.
  // `examples/deploy-cloudflare` is excluded for the same reason and by the
  // same rule: it *imports* that entry, which would drag the Workers globals
  // back into this program. It typechecks under apps/worker/tsconfig.json
  // (`npm run typecheck:worker`), where those globals are declared.
  "exclude": ["src/cloudflare", "examples/deploy-cloudflare"]
}
